---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tools | Dungeons and Datums"
  description="OSR and Old School D&D tools from Dungeons and Datums"
>
  <div class="container mx-auto px-4 py-16 max-w-4xl">
    <h1 class="text-5xl font-bold mb-6 text-center">Tools</h1>
    <p class="text-xl text-center text-base-content/80 mb-12">
      OSR gaming tools and utilities for Old School D&D campaigns
    </p>

    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Retired</h2>
        <p class="text-base-content/80">
          The ODD Character Generator and the Campaign Region Generator have
          been retired and are no longer online.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
